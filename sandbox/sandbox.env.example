# =============================================================================
# Per-project sandbox knobs — copied to <project>/.sandbox.env by
# `just new <name>`.
# =============================================================================
# Consumed by docker compose via the Justfile's --env-file flag —
# compose's own config input, applied at parse time (VM-side) when
# rendering compose.sandbox.yaml (+ the ports/dsh overrides when active):
# these values substitute the ${VAR} placeholders (windows, cpu/mem
# ceilings, the DSH port). The FILE itself is never injected into the
# container; an individual value only reaches the sandbox where the
# compose files explicitly interpolate it into an `environment:` entry —
# today: DSH_PORT and DSH_TRUSTED_HOSTS in compose.dsh.yaml. Everything
# else here stays host-side (cgroups, windows).
#
# FLAVOR-AGNOSTIC BY DESIGN: which agent flavor a sandbox runs is chosen
# by the VERB, not this file — `just up <name>` starts the OpenCode TUI
# sandbox, `just up <name>-dsh` the DeepSeek Harness one (both mount this
# same dir; containers/volumes/networks are namespaced by the suffix).
# A stale `SANDBOX_IMAGE=` line from an older template is ignored — the
# Justfile exports the flavor's image as an OS env var, which beats
# --env-file values; delete the line at your leisure.
#
# Deliberately NOT named `.env`: your repo probably has its own `.env`
# (the standard dotenv convention) — the sandbox never reads it, and
# your app never reads this. Different files, different consumers, no
# merging. Per-machine knobs usually stay uncommitted: add
# `.sandbox.env` to the project's .gitignore unless you want to share
# the settings with the team.
# =============================================================================

# Optional date-tag pin for ALL flavors of this dir (they are built
# together by `just build`, which tags every flavor the same day).
# Empty/unset = :latest. Pin a known-good day:
# IMAGE_TAG=20261120

# Resource ceilings for THIS sandbox (guards the shared VM pool).
# Concurrency note: every concurrently running sandbox — including a
# second flavor of the same dir — gets the FULL ceiling, so keep the
# product within the VM (defaults fit 2-4 concurrent sandboxes on 16GiB).
SANDBOX_CPUS=4.0
SANDBOX_MEM=8g
SANDBOX_PIDS=2048

# DSH web UI port on macOS — only the -dsh flavor consumes it.
# Give every concurrently running DSH project its own port:
#   proj-a: 3080   proj-b: 3081   proj-c: 3082
DSH_PORT=3080
# Extra DSH Host/Origin authorities, space-separated (host or host:port).
# Usually unnecessary: localhost:${DSH_PORT} and 127.0.0.1:${DSH_PORT} are
# trusted by the launcher.
# DSH_TRUSTED_HOSTS=

# --- Expose sandbox ports to macOS localhost (opt-in) --------------------------
# Web project with known, contiguous dev ports? Uncomment SANDBOX_PORTS
# and set the window to cover YOUR app's ports — published AS-IS
# (identity mapping: sandbox port N appears on Mac localhost:N for every
# N in the window; `just up` only; servers must bind 0.0.0.0 inside —
# `vite --host`):
#   vite :5173 + api :5174       -> PORT_BASE=5173 PORT_BASE_END=5199
#   vite :3000 + api :3001       -> PORT_BASE=3000 PORT_BASE_END=3019
# The -dsh flavor gets its OWN window (DSH_PORT_BASE below) — the two
# flavors of one dir never collide. Windows are per-FLAVOR constants,
# same numbers for every project; only concurrently running PROJECTS
# need distinct values, and a collision fails loudly at `up`
# ("port already allocated") like host docker does.
# One-off ports, scattered ports, or a live `just shell` session? Skip
# the window and use the ad-hoc verb instead:
#   just expose <name> 3000            (Mac :3000 -> sandbox :3000)
#   just expose <name>-dsh 3001:3000    (Mac :3001 -> dsh sandbox :3000)
#SANDBOX_PORTS=1
#PORT_BASE=3000            # window start: sandbox port == Mac port
#PORT_BASE_END=3199
#DSH_PORT_BASE=3200        # the -dsh flavor's window (replaces PORT_BASE
#DSH_PORT_BASE_END=3399    # for dsh sandboxes)

# Optional: per-project environment INSIDE the container (feature flags,
# tool env vars, proxy vars, entrypoint knobs like SANDBOX_DNS, dummy keys
# for extra gateway routes) can live in <project>/.ai.env — compose loads
# it into the sandbox when present. Different file, different direction:
# .sandbox.env feeds compose's ${VAR} substitution at parse time and is
# never injected wholesale; .ai.env is injected line-by-line into the
# container at start. Template: sandbox/ai.env.example.
