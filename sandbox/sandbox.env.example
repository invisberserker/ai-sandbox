# =============================================================================
# Per-project sandbox knobs — copied to <project>/.sandbox.env by
# `just new <name>`.
# =============================================================================
# Consumed by docker compose via the Justfile's --env-file flag —
# compose's own input, applied at parse time when rendering the base
# compose file plus the active ports/dsh overrides. These values substitute
# the ${VAR} placeholders (image tag, CPU/mem ceilings, port windows). The
# FILE itself is never injected into the container; a value reaches the
# sandbox only where a compose file explicitly interpolates it into an
# `environment:` entry — DSH_PORT and DSH_TRUSTED_HOSTS in
# compose.dsh.yaml. Everything else stays host-side.
#
# FLAVOR-AGNOSTIC BY DESIGN: the verb's project-name suffix chooses the
# flavor — `just up <name>` (OpenCode), `just up <name>-dsh` (DeepSeek
# Harness), `just up <name>-clean` (ai-whiteboard, no agent CLI). All mount
# this same dir; containers/volumes/networks are namespaced by the suffix.
#
# Deliberately NOT named `.env`: your repo probably has its own `.env`
# (the standard dotenv convention) — the sandbox never reads it, and your
# app never reads this. Different files, different consumers, no merging.
# Per-machine knobs usually stay uncommitted: add `.sandbox.env` to the
# project's .gitignore unless you want to share the settings with the team.
# =============================================================================

# Optional tag pin for ALL flavors of this dir (they are built together by
# `just build`). Any tag on ai-<flavor> works; empty/unset = latest.
# IMAGE_TAG=20261120

# Resource ceilings for THIS sandbox (guards the shared VM pool).
# Concurrency note: every concurrently running sandbox — including a
# second flavor of the same dir — gets the FULL ceiling, so keep the
# product within the VM (defaults fit 2-4 concurrent sandboxes on 16GiB).
SANDBOX_CPUS=4.0
SANDBOX_MEM=8g
SANDBOX_PIDS=2048

# DSH web UI port on macOS — only the -dsh flavor consumes it.
# Give every concurrently running DSH project its own port:
#   proj-a: 3080   proj-b: 3081   proj-c: 3082
DSH_PORT=3080
# Extra DSH Host/Origin authorities, space-separated (host or host:port).
# Usually unnecessary: localhost:${DSH_PORT} and 127.0.0.1:${DSH_PORT} are
# trusted by the launcher.
# DSH_TRUSTED_HOSTS=

# --- Expose sandbox ports to macOS localhost (opt-in) --------------------------
# Web project with known, contiguous dev ports? Uncomment SANDBOX_PORTS and
# set a window covering YOUR app's ports. Identity mapping: sandbox port N
# appears on Mac localhost:N; `just up` only; servers must bind 0.0.0.0
# inside (`vite --host`):
#   vite :5173 + api :5174       -> PORT_BASE=5173 PORT_BASE_END=5199
#   vite :3000 + api :3001       -> PORT_BASE=3000 PORT_BASE_END=3019
# The -dsh flavor uses its own window (DSH_PORT_BASE), not PORT_BASE. Give
# every concurrently running project-flavor a non-overlapping window; a
# collision fails loudly at `up` ("port already allocated") like host docker.
# One-off ports, scattered ports, or a live `just shell` session? Skip the
# window and use the ad-hoc verb instead:
#   just expose <name> 3000            (Mac :3000 -> sandbox :3000)
#   just expose <name>-dsh 3001:3000    (Mac :3001 -> dsh sandbox :3000)
#SANDBOX_PORTS=1
#PORT_BASE=3000            # window start: sandbox port == Mac port
#PORT_BASE_END=3199
#DSH_PORT_BASE=3200        # -dsh window (used only with SANDBOX_PORTS=1)
#DSH_PORT_BASE_END=3399

# Optional: per-project environment INSIDE the container (feature flags,
# tool env vars, proxy vars, entrypoint knobs like SANDBOX_DNS, dummy keys
# for extra gateway routes) can live in <project>/.ai.env — compose loads
# it into the sandbox when present. Different file, different direction:
# .sandbox.env feeds compose's ${VAR} substitution at parse time and is
# never injected wholesale; .ai.env is injected line-by-line into the
# container at start. Template: sandbox/ai.env.example.
