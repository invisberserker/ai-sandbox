# =============================================================================
# Per-project sandbox knobs — copied to <project>/.sandbox.env by
# `just new <name>`.
# =============================================================================
# Consumed by docker compose via the Justfile's --env-file flag —
# compose's own config input, applied at parse time (VM-side) when
# rendering compose.sandbox.yaml: these values substitute the ${VAR}
# placeholders (image, cpu/mem ceilings, published ports). The FILE
# itself is never injected into the container; an individual value only
# reaches the sandbox where the compose files explicitly interpolate it
# into an `environment:` entry — today: DSH_PORT and DSH_TRUSTED_HOSTS
# in compose.dsh.yaml, which the dsh-web launcher inside the container
# needs. Everything else here stays host-side (cgroups, ports, image).
#
# Deliberately NOT named `.env`: your repo probably has its own `.env`
# (the standard dotenv convention) — the sandbox never reads it, and
# your app never reads this. Different files, different consumers, no
# merging. Per-machine knobs usually stay uncommitted: add
# `.sandbox.env` to the project's .gitignore unless you want to share
# the settings with the team.
#
# Everything here overrides compose defaults; leave lines you don't care
# about. DSH_PORT and PORT_BASE need planning when projects run
# concurrently.
# =============================================================================

# Which agent flavor this project runs on. All flavors carry the SAME
# toolchains (node/ts, rust, python, go) and utils. Two carry an agent CLI:
#   ai-opencode     OpenCode TUI (OpenCode Go via the gateway)
#   ai-deepseek     DeepSeek Harness web UI (DeepSeek official via gateway)
#   ai-whiteboard   no agent CLI — a clean slate; bring your own ad-hoc
# Pin a date tag (e.g. ai-opencode:20261120) for a known-good day.
SANDBOX_IMAGE=ai-opencode:latest

# Resource ceilings for THIS sandbox (guards the shared VM pool).
SANDBOX_CPUS=4.0
SANDBOX_MEM=8g
SANDBOX_PIDS=2048

# DSH web UI port on macOS — ONLY used by `just dsh-up` (deepseek flavor).
# Give every concurrently running DSH project its own port:
#   proj-a: 3080   proj-b: 3081   proj-c: 3082
DSH_PORT=3080
# Extra DSH Host/Origin authorities, space-separated (host or host:port).
# Usually unnecessary: localhost:${DSH_PORT} and 127.0.0.1:${DSH_PORT} are
# trusted by the launcher.
# DSH_TRUSTED_HOSTS=

# Port slice forwarded to macOS localhost — ONLY used if you enable the
# `ports:` block in compose.sandbox.yaml and run via `just up`.
# Plan ~200 ports per project, no overlap between active projects:
#   proj-a: 3000-3199   proj-b: 3200-3399   proj-c: 3400-3599
PORT_BASE=3000
PORT_BASE_END=3199

# Optional: per-project environment INSIDE the container (feature flags,
# tool env vars, proxy vars, entrypoint knobs like SANDBOX_DNS, dummy keys
# for extra gateway routes) can live in <project>/.ai.env — compose loads
# it into the sandbox when present. Different file, different direction:
# .sandbox.env feeds compose's ${VAR} substitution at parse time and is
# never injected wholesale; .ai.env is injected line-by-line into the
# container at start. Template: sandbox/ai.env.example.
